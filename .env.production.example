# ==============================================================================
# ShareHub / CommunityMarketPlace — deployment configuration
# ==============================================================================
#
# The app itself reads NO environment variables.
#
# ShareHub ships as a static single-page app. Everything in a Vite build is
# readable by anyone who opens the bundle, so there is nowhere safe to put a
# database URL, an API key or an auth secret. Data lives in the visitor's own
# browser (localStorage) instead of a server.
#
# Earlier revisions of this file listed DATABASE_URL, BETTER_AUTH_SECRET and
# GOOGLE_CLIENT_SECRET. Those were never read by the running app and setting
# them in Amplify would have published them to every visitor. They are gone
# deliberately — do not add them back without a real server to hold them.
#
# The values below are only for the GitHub Actions deployment job. Set them as
# repository secrets, not in a committed .env file.
# ==============================================================================

# --- Required only for the S3 + CloudFront workflow (.github/workflows) -------

AWS_REGION="us-east-1"
AWS_S3_BUCKET_NAME="community-marketplace-production-123456789012"
AWS_CLOUDFRONT_DISTRIBUTION_ID="E1234EXAMPLEID"

# IAM credentials for the deploy user. Scope this user to s3:PutObject /
# s3:DeleteObject on the bucket and cloudfront:CreateInvalidation only.
AWS_ACCESS_KEY_ID="AKIA..."
AWS_SECRET_ACCESS_KEY="..."

# --- AWS Amplify Hosting ------------------------------------------------------
#
# Nothing to set. Amplify builds straight from amplify.yml.
#
# If your Amplify build fails during provisioning with
#   "CustomerError: Cannot read 'next' version in package.json"
# the app is registered as a Next.js SSR app. Fix it with:
#   ./aws/amplify-configure.sh <APP_ID> <REGION>
