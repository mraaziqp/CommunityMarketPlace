# ==============================================================================
# ShareHub server environment. Server-side only: never commit real values and
# never prefix them with VITE_ (anything VITE_ is published in the web bundle).
# scripts/aws/deploy.sh writes this file on the server from
# ~/.sharehub/production.env.
# ==============================================================================

NODE_ENV=production
PORT=8787
# Public address of the app (used for PayFast return/cancel/notify URLs).
PUBLIC_APP_URL=https://market.arpcloudsolutions.co.za

# Postgres. Migrations run automatically at start-up.
DATABASE_URL=postgres://sharehub:PASSWORD@HOST:5432/sharehub?sslmode=require

# Behind Caddy / a load balancer, read the client IP from X-Forwarded-For.
TRUST_PROXY=true
# Never seed demo listings or allow one-tap demo sign-in in production.
DEMO_MODE=false
# Emails that get the admin dashboard (comma-separated).
ADMIN_EMAILS=you@example.com

# --- PayFast ------------------------------------------------------------------
# sandbox | live. Sandbox needs your own sandbox merchant from sandbox.payfast.co.za.
PAYFAST_MODE=live
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
# Must match the passphrase set in PayFast > Settings > Developer Settings.
PAYFAST_PASSPHRASE=
# Defaults to $PUBLIC_APP_URL/api/webhooks/payfast. Only change it if another
# server receives notifications and forwards them here.
# PAYFAST_NOTIFY_URL=
# Sent as custom_str1 so a shared ecosystem handler can route notifications.
PAYFAST_APP_TAG=sharehub

# --- Ecosystem bot (/api/v1) ----------------------------------------------------
# One or more keys (comma-separated, 32+ characters each) for Authorization: Bearer.
BOT_API_KEYS=
# Optional: receive signed event webhooks.
BOT_WEBHOOK_URL=
BOT_WEBHOOK_SECRET=

# --- Firebase Storage (optional): photos + nightly backups -----------------------
# Without these, photos are stored in Postgres and backups rely on RDS snapshots.
# FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
# Service-account JSON key (Project settings > Service accounts), base64-encoded:
#   base64 -w0 key.json
# FIREBASE_SERVICE_ACCOUNT_BASE64=

# --- Email (Resend, optional) --------------------------------------------------
# Transactional emails (booking confirmations, pickup codes, receipts). The
# sending domain must be verified in Resend. Quote values containing spaces.
# RESEND_API_KEY=
# EMAIL_FROM="ShareHub <market@arpcloudsolutions.co.za>"
# EMAIL_REPLY_TO=
