# ==============================================================================
# CommunityMarketPlace - Production Environment Configuration for AWS
# ==============================================================================

# Public URL where the application is hosted on AWS (CloudFront domain or custom domain)
# Example: https://d123456abcdef8.cloudfront.net or https://marketplace.example.com
VITE_APP_URL="https://your-cloudfront-distribution.cloudfront.net"

# Google Gemini AI API Key for generative features
VITE_GEMINI_API_KEY="AIzaSy..."

# PostgreSQL Database Connection String (Neon Serverless or Amazon RDS/Aurora PostgreSQL)
# Example: postgresql://username:password@ep-project-12345.us-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Better Auth Configuration (if using server endpoints)
BETTER_AUTH_SECRET="your-32-character-random-secret-key-here"
BETTER_AUTH_URL="https://your-cloudfront-distribution.cloudfront.net"

# AWS Deployment Parameters
AWS_REGION="us-east-1"
AWS_S3_BUCKET_NAME="community-marketplace-production-123456789012"
AWS_CLOUDFRONT_DISTRIBUTION_ID="E1234EXAMPLEID"
